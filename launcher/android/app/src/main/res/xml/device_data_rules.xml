<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore keys cannot be restored on a different device. The
         launcher and its storage plugins use ordinary app preferences;
         exclude that entire directory, including the encrypted records. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
