<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore keys cannot be restored on a different device. Keep both
         the encrypted records and the local activation state on this device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
